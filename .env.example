# ---------- Obrigatório em produção ----------
# Criptografa as credenciais das integrações. Gere com:  openssl rand -hex 32
# NÃO troque depois de salvar integrações (elas ficariam ilegíveis).
ENCRYPTION_KEY=

# Assina o cookie de login. Gere com:  openssl rand -hex 32
AUTH_SECRET=

# Quem pode entrar no painel (um login por pessoa, separados por vírgula)…
APP_USERS=voce@empresa.com:senha-forte,socio@empresa.com:outra-senha
# …ou uma senha única compartilhada (o campo e-mail fica livre)
# APP_PASSWORD=

# Banco Postgres. No Railway é preenchido automaticamente ao adicionar o Postgres.
# Sem ele, as credenciais ficam em data/connections.json (só serve para rodar local).
DATABASE_URL=

# ---------- Opcional ----------
CURRENCY=USD
